# Copy this file to .env and fill in real values. NEVER commit .env to git.

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/kinderwoow
# Set to true when the database requires SSL (e.g. Render "External Database URL")
DATABASE_SSL=false

# First admin account, created on the first start only (use a long random password).
# More accounts are added later in the admin panel, section "Users".
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random secret for signing admin sessions, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Booking notification e-mails. Option 1 (recommended on DigitalOcean, which blocks SMTP ports):
# Resend API key from https://resend.com/api-keys. Without a verified domain, Resend only delivers
# to the e-mail address of your Resend account, so use that address as NOTIFY_EMAIL.
RESEND_API_KEY=
# Sender; keep the default until the domain is verified in Resend, then e.g. KinderWoow <info@kinderwoow.de>
#MAIL_FROM=KinderWoow Website <onboarding@resend.dev>

# Option 2: Gmail account used to send booking notifications (use an App Password, not your normal password)
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where notifications are delivered (defaults to GMAIL_USER)
NOTIFY_EMAIL=your-address@gmail.com

# Public address of the website (canonical links, hreflang, sitemap.xml)
SITE_URL=https://kinderwoow.de

# Set to production on the live server (enables Secure cookies)
NODE_ENV=development

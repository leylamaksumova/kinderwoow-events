# Copy this file to .env and fill in real values. NEVER commit .env to git.

# PostgreSQL connection string
DATABASE_URL=postgres://user:password@localhost:5432/kinderwoow
# Set to true when the database requires SSL (e.g. Render "External Database URL")
DATABASE_SSL=false

# Admin panel password (use a long random password, not "admin")
ADMIN_PASSWORD=change-me
# Random secret for signing admin sessions, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# Gmail account used to send booking notifications (use an App Password, not your normal password)
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where notifications are delivered (defaults to GMAIL_USER)
NOTIFY_EMAIL=your-address@gmail.com

# Set to production on the live server (enables Secure cookies)
NODE_ENV=development
